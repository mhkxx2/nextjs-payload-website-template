# PostgreSQL connection used by Payload. Replace the local-only example password.
DATABASE_URI=postgresql://alrukn_app:local-development-only@127.0.0.1:5432/alrukn_furniture

# Replace with at least 32 random characters. Never commit a real value.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Canonical public URL. No trailing slash.
NEXT_PUBLIC_SERVER_URL=https://alruknfurniture.ae

# Replace each operational secret independently. Never commit real values.
PREVIEW_SECRET=replace-with-a-separate-random-secret
REVALIDATION_SECRET=replace-with-a-separate-random-secret
