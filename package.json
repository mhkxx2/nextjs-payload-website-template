{
  "name": "alrukn-payload-website",
  "version": "1.0.0",
  "description": "Al Rukn Furniture website and content platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "env:check": "node scripts/assert-production-env.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "import:eco-portfolio": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/import-eco-furniture-portfolio.ts",
    "verify:eco-portfolio": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/verify-eco-furniture-portfolio.ts",
    "import:curtains-blinds": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/import-curtains-blinds-catalogue.ts",
    "verify:curtains-blinds": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/verify-curtains-blinds-catalogue.ts",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings=0",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:generate-types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:a11y": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.a11y.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/integration",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/unit",
    "test:security": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts tests/security",
    "test:performance": "lhci autorun",
    "typecheck": "tsc --noEmit",
    "release:gate": "pnpm env:check && pnpm template:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build",
    "template:check": "node scripts/assert-template-clean.mjs"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.89.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-nodemailer": "3.89.0",
    "@payloadcms/live-preview-react": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-form-builder": "3.89.0",
    "@payloadcms/plugin-nested-docs": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-search": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "payload": "3.89.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "pg": "^8.23.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
